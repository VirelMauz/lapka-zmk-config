#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,physical-layout = &physical_layout0;
		zmk,kscan = &mock_kscan;
		zephyr,display = &oled;
	};

	ext_power_ctrl: ext-power {
		compatible = "zmk,ext-power-generic";
		label = "EXT_POWER";
		control-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		init-delay-ms = <50>;
	};

	mock_kscan: mock_kscan_0 {
		compatible = "zmk,kscan-mock";
		columns = <0>;
		rows = <0>;
		events = <0>;
	};
};

/* OLED SH1106 */
&pro_micro_i2c {
	status = "okay";

	oled: sh1106@3c {
		compatible = "sinowealth,sh1106";
		reg = <0x3c>;
		label = "OLED";
		width = <128>;
		height = <64>;
		segment-offset = <2>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		inversion-on;
		prechargep = <0x22>;
	};
};
