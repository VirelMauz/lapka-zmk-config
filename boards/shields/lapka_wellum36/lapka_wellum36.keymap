#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define _ &kp
#define ___ &none
#define ______ &trans

#define DEF 0
#define GAM 1
#define GFN 2
#define NAV 3
#define SYM 4
#define NUM 5
#define CMD 6

#define MEH(key) LS(LC(LA(key)))

#define SQT GRAVE
#define DQT LS(GRAVE)
#define GRV RA(GRAVE)
#define PIP LS(BSLH)
#define BSL RA(BSLH)
#define NBSP RA(SPACE)
#define NSPC LC(LG(RIGHT))
#define PSPC LC(LG(LEFT))

/* ==================== CUSTOM BEHAVIORS ==================== */

&sk {
    release-after-ms = <60000>;
};

&macro_param_1to1 { /* для удобства */ };

/ {
    behaviors {
        /* Макросы для double-press/release (твоя Callum-логика) */
        m_release_key_twice: m_release_key_twice {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_release &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                       <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };

        m_press_key_twice: m_press_key_twice {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                       <&macro_tap &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                       <&macro_pause_for_release>,
                       <&m_release_key_twice MACRO_PLACEHOLDER>;
        };

        sticky_forever: sticky_forever {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&m_press_key_twice>;
            release-after-ms = <600000>;
            ignore-modifiers;
        };

        /* Callum Mods */
        cm_gui: cm_gui {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LGUI>, <&m_release_key_twice LGUI>;
            mods = <MOD_LGUI>;
            keep-mods = <MOD_LGUI>;
        };

        cm_alt: cm_alt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LALT>, <&m_release_key_twice LALT>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        cm_ctrl: cm_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LCTRL>, <&m_release_key_twice LCTRL>;
            mods = <MOD_LCTL>;
            keep-mods = <MOD_LCTL>;
        };

        cm_sft: cm_sft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LSHIFT>, <&m_release_key_twice LSHIFT>;
            mods = <MOD_LSFT>;
            keep-mods = <MOD_LSFT>;
        };

        /* Tabber / Swapper */
        tabber: tabber {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LCTRL TAB>, <&kp TAB>;
            mods = <MOD_LCTL>;
            keep-mods = <MOD_LCTL>;
        };

        swapper_win: swapper_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LALT TAB>, <&kp TAB>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        swapper_mac: swapper_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LGUI TAB>, <&kp TAB>;
            mods = <MOD_LGUI>;
            keep-mods = <MOD_LGUI>;
        };

        m_hold_mod_press_key: m_hold_mod_press_key {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                       <&macro_tap &macro_param_2to1 &kp MACRO_PLACEHOLDER>;
        };

        /* Layer Activation с очисткой модов */
        la: la {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp 0>,                    /* fire stickies */
                       <&macro_press &macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                       <&macro_pause_for_release>,
                       <&macro_release &macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                       <&kp LSHFT>, <&kp LCTRL>, <&kp LALT>, <&kp LGUI>;
        };

        /* Твой caps_combo */
        caps_combo: caps_combo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LSHIFT &kp N3>,
                       <&macro_pause_for_release>,
                       <&macro_release &kp LCTRL &kp LSHIFT &kp N3>,
                       <&macro_tap &kp CAPS>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <NUM>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        def_layer {
            bindings = <
_ Q _ W _ E _ R _ T _ Y _ U _ I _ O _ P
_ A _ S _ D _ F _ G _ H _ J _ K _ L _ SEMI
_ Z _ X _ C _ V _ B _ N _ M _ COMMA _ DOT _ FSLH
                          &caps_combo _ SPACE &la NAV &la SYM _ LSFT _ RALT
            >;
        };

        /* Остальные слои без изменений (gam_layer, gfn_layer, nav_layer и т.д.) */
        gam_layer { /* ... */ };
        gfn_layer { /* ... */ };
        nav_layer { /* ... */ };
        sym_layer { /* ... */ };
        num_layer { /* ... */ };
        cmd_layer { /* ... */ };
    };
};
