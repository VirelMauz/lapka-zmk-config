#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define _ &kp
#define ___ &none
#define ______ &trans

#define DEF 0
#define GAM 1
#define GFN 2
#define NAV 3
#define SYM 4
#define NUM 5
#define CMD 6

#define MEH(key) LS(LC(LA(key)))

/* SQT и DQT не переопределяем — они уже есть в keys.h */
#define PIP LS(BSLH)
#define BSL RA(BSLH)
#define NBSP RA(SPACE)

#define NSPC LC(LG(RIGHT))
#define PSPC LC(LG(LEFT))

// ---------- Макросы (оставлены только те, что нужны) ----------
#define MACRO_TWO_PARAM(NAME, BINDINGS) \
    NAME: NAME { \
        compatible = "zmk,behavior-macro-two-param"; \
        #binding-cells = <2>; \
        wait-ms = <0>; \
        tap-ms = <0>; \
        bindings = <BINDINGS>; \
    }

#define MACRO_NO_PARAM(NAME, BINDINGS) \
    NAME: NAME { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        wait-ms = <0>; \
        tap-ms = <0>; \
        bindings = <BINDINGS>; \
    }

MACRO_TWO_PARAM(
    m_hold_mod_press_key,
    &macro_press &macro_param_1to1 &kp PARAM_1;
    &macro_tap &macro_param_2to1 &kp PARAM_2
)

MACRO_NO_PARAM(
    caps_combo,
    &macro_press &kp LCTRL &kp LSHIFT &kp N3;
    &macro_pause_for_release;
    &macro_release &kp LCTRL &kp LSHIFT &kp N3;
    &macro_tap &kp CAPS
)

// ---------- Кастомные поведения (включая la) ----------
/ {
    behaviors {
        /* Макрос для активации слоя со сбросом всех стиков */
        la: la {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap &kp 0>,
                <&macro_press &macro_param_1to1 &mo PARAM_1>,
                <&macro_pause_for_release>,
                <&macro_release &macro_param_1to1 &mo PARAM_1>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp LCTRL>,
                <&macro_release &kp LALT>,
                <&macro_release &kp LGUI>;
        };

        // Липкие модификаторы (таймаут 60 секунд)
        cm_gui: cm_gui {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <0>;
            bindings = <&kp LGUI>;
            release-after-ms = <60000>;
            ignore-modifiers;
        };
        cm_alt: cm_alt {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <0>;
            bindings = <&kp LALT>;
            release-after-ms = <60000>;
            ignore-modifiers;
        };
        cm_ctrl: cm_ctrl {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>;
            release-after-ms = <60000>;
            ignore-modifiers;
        };
        cm_sft: cm_sft {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT>;
            release-after-ms = <60000>;
            ignore-modifiers;
        };

        // Tabber и Swapper'ы (без изменений)
        MODMORPH(
            tabber,
            &m_hold_mod_press_key LCTRL TAB,
            &kp TAB,
            MOD_LCTL,
            MOD_LCTL
        )
        MODMORPH(
            swapper_win,
            &m_hold_mod_press_key LALT TAB,
            &kp TAB,
            MOD_LALT,
            MOD_LALT
        )
        MODMORPH(
            swapper_mac,
            &m_hold_mod_press_key LGUI TAB,
            &kp TAB,
            MOD_LGUI,
            MOD_LGUI
        )
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers  = <NAV SYM>;
            then-layer = <NUM>;
        };
    };
};

// ---------- Слои (без изменений) ----------
/ {
    keymap {
        compatible = "zmk,keymap";

        def_layer {
            bindings = <
_ Q          _ W          _ E          _ R         _ T             _ Y          _ U          _ I          _ O          _ P
_ A          _ S          _ D          _ F         _ G             _ H          _ J          _ K          _ L          _ SEMI
_ Z          _ X          _ C          _ V         _ B             _ N          _ M          _ COMMA      _ DOT        _ FSLH
                          &caps_combo   _ SPACE     &la NAV         &la SYM      _ LSFT       _ RALT
            >;
        };

        gam_layer {
            bindings = <
_ TAB        _ Q          _ W          _ E         _ R             ___          ___          _ UP         ___          _ TAB
_ LSFT       _ A          _ S          _ D         _ F             ___          _ LEFT       _ DOWN       _ RIGHT      _ RSFT
_ LCTRL      _ Z          _ X          _ C         _ V             ___          ___          ___          ___          _ RCTRL
                          _ LALT       _ SPACE     &mo GFN         &tog GAM     _ SPACE      ______
            >;
        };

        gfn_layer {
            bindings = <
_ N5         _ N1         _ N2         _ N3        _ N4            &out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1   &bt BT_SEL 2 &bt BT_CLR_ALL
_ N0         _ N6         _ N7         _ N8        _ N9            ___          ___          ___            ___          ___
_ G          _ J          _ I          _ M         _ T             _ KP_NUM     ___          ___            &sys_reset   &bootloader
                          _ ESC        _ RET       ______          ______       ______       ___
            >;
        };

        nav_layer {
            bindings = <
&tabber      &swapper_win &swapper_mac ___         _ ESC           _ ESC        _ HOME       _ END        _ BSPC       _ DEL
&cm_gui      &cm_alt      &cm_ctrl     &cm_sft     _ RET           _ RET        _ LEFT       _ DOWN       _ UP         _ RIGHT
_ PSPC       _ NSPC       &tog GAM     _ PSCRN     _ TAB           _ TAB        _ PG_UP      _ PG_DN      _ APOS       _ KP_NUM
                          &mo CMD      ______      ______          ______       ______       ______
            >;
        };

        sym_layer {
            bindings = <
_ N1         _ N2         _ N3         _ N4        _ N5            _ N6         _ N7         _ N8         _ N9         _ N0
_ SEMI       _ GRV        _ SQT        _ DQT       _ MINUS         _ PLUS       &cm_sft      &cm_ctrl     &cm_alt      &cm_gui
_ BSL        ___          _ LS(LBKT)   _ LBKT      _ UNDER         _ EQUAL      _ RBKT       _ LS(RBKT)   _ PIP        _ BSLH
                          ______       ______      ______          ______       ______       _ RALT
            >;
        };

        num_layer {
            bindings = <
_ KP_N1      _ KP_N2      _ KP_N3      _ KP_N4     _ KP_N5         _ KP_N6      _ KP_N7      _ KP_N8      _ KP_N9      _ KP_N0
&cm_gui      &cm_alt      &cm_ctrl     &cm_sft     _ F11           _ F12        &cm_sft      &cm_ctrl     &cm_alt      &cm_gui
_ F1         _ F2         _ F3         _ F4        _ F5            _ F6         _ F7         _ F8         _ F9         _ F10
                          ______       ______      ______          ______       ______       ______
            >;
        };

        cmd_layer {
            bindings = <
_ MEH(Q)     _ MEH(W)     _ MEH(E)     _ MEH(R)    _ MEH(T)        _ MEH(Y)     _ C_VOL_DN   _ C_MUTE     _ C_VOL_UP   _ MEH(P)
_ MEH(A)     _ MEH(S)     _ MEH(D)     _ MEH(F)    _ MEH(G)        _ MEH(H)     _ C_PREV     _ C_PP       _ C_NEXT     _ MEH(SEMI)
_ MEH(Z)     _ MEH(X)     _ MEH(C)     _ MEH(V)    _ MEH(B)        _ MEH(N)     _ MEH(M)     _ MEH(COMMA) _ MEH(DOT)   _ MEH(FSLH)
                          ______       ______      ______          ______       ______       ______
            >;
        };
    };
};
